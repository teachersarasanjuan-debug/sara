# Public Supabase settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase secret key (never prefix with NEXT_PUBLIC_)
SUPABASE_SECRET_KEY=

# Vercel AI Gateway: Vercel deployments can use VERCEL_OIDC_TOKEN.
# Local dev needs AI_GATEWAY_API_KEY.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=

# Stripe TEST keys first. Switch to live only after pricing, tax and legal review.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Exact public application origin, e.g. https://ai.teachersara.es
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to true only after privacy, parental-consent and safeguarding approval.
CHILD_AI_ENABLED=false