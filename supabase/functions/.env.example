# Supabase injects SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY into Edge Functions.
# Browser configuration uses only the public publishable key in ai/config.js.
# NEVER commit any secret value to GitHub or ai/config.js.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-terra
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_INDIVIDUAL_MONTHLY=

APP_PUBLIC_URL=https://teachersara.es
APP_ALLOWED_ORIGINS=https://teachersara.es,https://www.teachersara.es
AI_FREE_MONTHLY_REQUEST_LIMIT=10
AI_PAID_MONTHLY_REQUEST_LIMIT=500
AI_VOICE_MONTHLY_SESSION_LIMIT=12

# Keep disabled until voice cost controls, privacy wording and test-mode behaviour are verified.
ENABLE_REALTIME_VOICE=false
# Child mode must remain disabled pending parent/guardian and safeguarding work.
ENABLE_CHILD_MODE=false
