# Supabase injects project URL and API key objects into Edge Functions.
# Browser configuration uses only the public publishable key.
# NEVER add secret values to GitHub or ai/config.js.

OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_INDIVIDUAL_MONTHLY=
APP_PUBLIC_URL=https://teachersara.es
APP_ALLOWED_ORIGINS=https://teachersara.es,https://www.teachersara.es
AI_FREE_MONTHLY_REQUEST_LIMIT=10
AI_PAID_MONTHLY_REQUEST_LIMIT=500
AI_VOICE_MONTHLY_SESSION_LIMIT=12
ENABLE_REALTIME_VOICE=false
ENABLE_CHILD_MODE=false
